# Copy to .env and fill in. Without a key, run everything with --mock.
# Trial keys are free: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Hard ceiling on live API calls per calendar month. Trial keys get 1,000.
# The ledger in cache/live/ledger.jsonl refuses calls past this number.
R7B_MONTHLY_CALL_CAP=1000

# Calls held back from the cap for retries and smoke tests.
R7B_CALL_RESERVE=40
